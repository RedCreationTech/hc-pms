{
  "title": "红创PMS 产品功能演示",
  "subtitle": "从立项到关闭的完整本地闭环",
  "scenes": [
    {
      "id": "01",
      "title": "登录与工作台",
      "lines": [
        { "id": "01-1", "text": "使用管理员账号登录红创PMS系统。" },
        { "id": "01-2", "text": "工作台汇总用户, 日志与定时任务等运行指标。" },
        { "id": "01-3", "text": "左侧菜单按当前用户权限动态加载。" }
      ]
    },
    {
      "id": "02",
      "title": "立项与模板",
      "lines": [
        { "id": "02-1", "text": "在项目中心创建设备订单项目。" },
        { "id": "02-2", "text": "一键应用单机设备订单模板, 生成三层结构。" },
        { "id": "02-3", "text": "关口, 计划容器与收尾清单同步生成。" }
      ]
    },
    {
      "id": "03",
      "title": "需求与审批",
      "lines": [
        { "id": "03-1", "text": "登记URS需求并上传证据文件版本。" },
        { "id": "03-2", "text": "编制项目章程并提交独立审批。" },
        { "id": "03-3", "text": "审核人在我的待办中批准, 提交人不能自审。" }
      ]
    },
    {
      "id": "04",
      "title": "计划与基线",
      "lines": [
        { "id": "04-1", "text": "按模板一键派生主, 子与单机计划。" },
        { "id": "04-2", "text": "拉长装配工期后, 系统自动定位主子冲突。" },
        { "id": "04-3", "text": "计划基线经独立审核人批准后冻结。" }
      ]
    },
    {
      "id": "05",
      "title": "执行与交付",
      "lines": [
        { "id": "05-1", "text": "配置交付要求, 项目进入执行阶段。" },
        { "id": "05-2", "text": "齐套缺口未补齐时, 装配开工被系统阻断。" },
        { "id": "05-3", "text": "SIT与FAT试验登记实测结果并批准。" },
        { "id": "05-4", "text": "发运前确认入库条件, 客户签收完成闭环。" }
      ]
    },
    {
      "id": "06",
      "title": "进度与财务",
      "lines": [
        { "id": "06-1", "text": "任务反馈实际日期, 驱动进度与挣值分析。" },
        { "id": "06-2", "text": "工时经独立审核人批准计入费用。" },
        { "id": "06-3", "text": "概算, 预算, 核算, 决算四版拉通对比。" }
      ]
    },
    {
      "id": "07",
      "title": "看板与检索",
      "lines": [
        { "id": "07-1", "text": "项目组合看板汇总进度, 成本与关口指标。" },
        { "id": "07-2", "text": "全局检索跨项目聚合需求与文档。" },
        { "id": "07-3", "text": "项目驾驶舱呈现组合概况与逾期预警。" }
      ]
    },
    {
      "id": "08",
      "title": "收尾与关闭",
      "lines": [
        { "id": "08-1", "text": "全部叶任务完成后进入收尾阶段。" },
        { "id": "08-2", "text": "收尾清单逐项确认后提交关闭审批。" },
        { "id": "08-3", "text": "批准关闭后项目只读, 重开须受控审批。" }
      ]
    }
  ]
}
