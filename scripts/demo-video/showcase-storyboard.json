{
  "title": "红创PMS 产品功能演示",
  "subtitle": "从立项到关闭的完整本地闭环",
  "scenes": [
    {
      "id": "01",
      "title": "登录与工作台",
      "lines": [
        {
          "id": "01-1",
          "text": "使用管理员账号登录红创PMS系统。"
        },
        {
          "id": "01-2",
          "text": "工作台汇总用户, 日志与定时任务等运行指标。"
        },
        {
          "id": "01-3",
          "text": "左侧菜单按当前用户权限动态加载。"
        }
      ]
    },
    {
      "id": "02",
      "title": "立项与模板",
      "lines": [
        {
          "id": "02-1",
          "text": "在项目中心创建设备订单项目。"
        },
        {
          "id": "02-2",
          "text": "一键应用单机设备订单模板, 生成三层结构。"
        },
        {
          "id": "02-3",
          "text": "关口, 计划容器与收尾清单同步生成。"
        }
      ]
    },
    {
      "id": "03",
      "title": "需求与审批",
      "lines": [
        {
          "id": "03-1",
          "text": "登记URS需求并上传证据文件版本。"
        },
        {
          "id": "03-2",
          "text": "编制项目章程并提交独立审批。"
        },
        {
          "id": "03-3",
          "text": "审核人在我的待办中批准, 提交人不能自审。"
        }
      ]
    },
    {
      "id": "04",
      "title": "计划与基线",
      "lines": [
        {
          "id": "04-1",
          "text": "按模板一键派生主, 子与单机计划。"
        },
        {
          "id": "04-2",
          "text": "拉长装配工期后, 系统自动定位主子冲突。"
        },
        {
          "id": "04-3",
          "text": "计划基线经独立审核人批准后冻结。"
        }
      ]
    },
    {
      "id": "05",
      "title": "执行与交付",
      "lines": [
        {
          "id": "05-1",
          "text": "配置交付要求, 项目进入执行阶段。"
        },
        {
          "id": "05-2",
          "text": "齐套缺口未补齐时, 装配开工被系统阻断。"
        },
        {
          "id": "05-3",
          "text": "SIT与FAT试验登记实测结果并批准。"
        },
        {
          "id": "05-4",
          "text": "发运前确认入库条件, 客户签收完成闭环。"
        }
      ]
    },
    {
      "id": "06",
      "title": "进度与财务",
      "lines": [
        {
          "id": "06-1",
          "text": "任务反馈实际日期, 驱动进度与挣值分析。"
        },
        {
          "id": "06-2",
          "text": "工时经独立审核人批准计入费用。"
        },
        {
          "id": "06-3",
          "text": "概算, 预算, 核算, 决算四版拉通对比。"
        }
      ]
    },
    {
      "id": "07",
      "title": "看板与检索",
      "lines": [
        {
          "id": "07-1",
          "text": "项目组合看板汇总进度, 成本与关口指标。"
        },
        {
          "id": "07-2",
          "text": "全局检索跨项目聚合需求与文档。"
        },
        {
          "id": "07-3",
          "text": "项目驾驶舱呈现组合概况与逾期预警。"
        }
      ]
    },
    {
      "id": "09",
      "title": "售前资料交接",
      "lines": [
        {
          "id": "09-1",
          "text": "按项目产品线自动生成应交资料清单。"
        },
        {
          "id": "09-2",
          "text": "缺必交资料时提交被阻断, 并点名缺料。"
        },
        {
          "id": "09-3",
          "text": "补交齐备后由独立审核人批准。"
        }
      ]
    },
    {
      "id": "10",
      "title": "计划技能匹配与执行洞察",
      "lines": [
        {
          "id": "10-1",
          "text": "任务所需技能与人力掌握技能逐条比对。"
        },
        {
          "id": "10-2",
          "text": "未排人力视为全部缺失, 只提示不阻断。"
        },
        {
          "id": "10-3",
          "text": "进度卷积据此定位关键路径与偏差。"
        }
      ]
    },
    {
      "id": "11",
      "title": "治理洞察汇总",
      "lines": [
        {
          "id": "11-1",
          "text": "范围排除项与验收准则逐条映射。"
        },
        {
          "id": "11-2",
          "text": "检验方法与执行角色交叉覆盖统计。"
        },
        {
          "id": "11-3",
          "text": "风险复审频率分布与到期节奏。"
        },
        {
          "id": "11-4",
          "text": "历史资料保留策略按作废与恢复聚合。"
        }
      ]
    },
    {
      "id": "12",
      "title": "受控取消与直发链路",
      "lines": [
        {
          "id": "12-1",
          "text": "取消申请必须关联已批准的变更依据。"
        },
        {
          "id": "12-2",
          "text": "批准后立即停止该范围后续下发。"
        },
        {
          "id": "12-3",
          "text": "未执行外发记录列为待补偿对账项。"
        },
        {
          "id": "12-4",
          "text": "直发链路校验层流罩与非层流罩条件。"
        }
      ]
    },
    {
      "id": "13",
      "title": "平台能力与运行就绪",
      "lines": [
        {
          "id": "13-1",
          "text": "平台能力页汇总支持数据库与兼容基线。"
        },
        {
          "id": "13-2",
          "text": "运行就绪核对真实探测数据库往返耗时。"
        },
        {
          "id": "13-3",
          "text": "迁移版本对账与关键配置在位如实呈现。"
        }
      ]
    },
    {
      "id": "14",
      "title": "搜索审计与通知",
      "lines": [
        {
          "id": "14-1",
          "text": "全局检索跨项目聚合需求, 风险与文档。"
        },
        {
          "id": "14-2",
          "text": "操作日志按真实请求留痕, 可追溯。"
        },
        {
          "id": "14-3",
          "text": "本地通知收件箱汇总待办与失败重试。"
        }
      ]
    },
    {
      "id": "08",
      "title": "收尾与关闭",
      "lines": [
        {
          "id": "08-1",
          "text": "全部叶任务完成后进入收尾阶段。"
        },
        {
          "id": "08-2",
          "text": "收尾清单逐项确认后提交关闭审批。"
        },
        {
          "id": "08-3",
          "text": "批准关闭后项目只读, 重开须受控审批。"
        }
      ]
    }
  ]
}
